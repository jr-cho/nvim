#!/usr/bin/env bash
# Runs one headless test file under a hard time limit.
#
# Two failure modes make the limit necessary.
#
# 1. Test invocations must not carry -c 'qa!'. The checks in lua/testkit.lua run
#    on a deferred timer, and qa! quits about 20ms in, before that timer fires.
#    The command then exits 0 whether the assertions passed or failed.
#    M.finish() calls os.exit() itself, so nothing else needs to end the process.
# 2. With qa! gone, a test file that errors before reaching M.run — a bad
#    require or a syntax error — runs no Lua at all, so
#    testkit's own watchdog never arms and Neovim idles forever.
#
# macOS ships no coreutils `timeout`, so perl's alarm provides the bound. perl
# is at /usr/bin/perl on every macOS install.
#
# This config lives at ~/.config/nvim, the default, so no NVIM_APPNAME is set
# and a bare `nvim` here loads the config under test.
#
# The previous config is kept at ~/.config/bak-nvim. Run it with
# NVIM_APPNAME=bak-nvim, which also moves its plugin data to
# ~/.local/share/bak-nvim so the two never share state.
#
# Usage: tests/nvim-test tests/boot.lua [extra nvim args...]
#   e.g. tests/nvim-test tests/vimade.lua -c 'Lazy! load vimade'
set -u

if [ $# -lt 1 ]; then
	echo "usage: tests/nvim-test <test-file.lua> [extra nvim args...]" >&2
	exit 64
fi

test_file="$1"
shift

cd "$(dirname "$0")/.."

exec perl -e 'alarm shift; exec @ARGV or die "exec failed: $!"' 35 \
	nvim --headless "$@" -c "luafile $test_file" </dev/null
